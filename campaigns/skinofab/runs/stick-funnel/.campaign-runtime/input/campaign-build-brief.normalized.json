{
  "schema_version": "campaigns-os-build-brief/v1",
  "campaign_intent": {
    "audience": "Women 45+ with dry, mature skin and fair to medium skin tones (persona: Linda, 56) who have tried many foundations and fear the wrong shade, a cakey look and lines",
    "conversion_goal": "Warm cold traffic with the listicle, convert on the product page and checkout, raise AOV with four post-purchase offers; every package is a subscription",
    "tone": "clear, practical, benefit-led",
    "compliance": {
      "approved_claims": [
        "goes on white and adapts to fair to medium skin tones as you blend",
        "made not to settle into fine lines (hedged until the 6-hour wear panel)",
        "skincare-infused foundation with PDRN, peptides and Volufiline",
        "fragrance-free",
        "made for skin after 45",
        "30-day money-back guarantee, even opened"
      ],
      "forbidden_claims": [
        "SPF or sun protection",
        "reverses aging / age-reversing / look 35",
