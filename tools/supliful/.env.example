# Copy to /.env (repo root, gitignored) or set in the host's secret store. Never commit real values.

# --- Supliful (Supliful app > Stores > "Supliful API" card > Create connection; key is shown once)
SUPLIFUL_BASE_URL=https://public-api.supliful.com
SUPLIFUL_API_KEY=
# Webhooks tab of the same connection; comma separated, two values during a secret rotation
SUPLIFUL_WEBHOOK_SECRETS=
# Orders are testMode (sandbox, never charged) until this is 1. A live order is charged at creation.
SUPLIFUL_LIVE_ORDERS=0
# Rehearsal only, against a development store: let testMode webhook events change Shopify
SUPLIFUL_PROCESS_TEST_EVENTS=0

# --- Shopify (Admin > Settings > Apps > Develop apps > custom app)
# Scopes: read_products, write_products, read_orders, write_orders,
#         read_merchant_managed_fulfillment_orders, write_merchant_managed_fulfillment_orders
SHOPIFY_STORE_DOMAIN=mediclab-2.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# The custom app's API secret key (signs webhooks)
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_VENDOR=Mediclab
SHOPIFY_PRODUCT_TYPE=Specialty Supplements
SHOPIFY_NOTIFY_CUSTOMER=1

# --- Bridge server
PORT=8787
SUPLIFUL_STATE_DIR=.supliful-state
